<?xml version="1.0" encoding="utf-8"?>
<!--
    Robot app runs on a local WiFi network with the ESP32.
    Cleartext (ws://) is allowed everywhere: this app never talks to the internet,
    only to embedded hardware on the local network.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
